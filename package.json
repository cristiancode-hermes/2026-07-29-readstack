{
  "name": "readstack",
  "version": "1.0.0",
  "private": true,
  "description": "ReadStack — Book tracking and reading list manager",
  "workspaces": ["apps/*"],
  "scripts": {
    "build:api": "cd apps/api && ../../node_modules/.bin/tsc",
    "build:web": "cd apps/web && node ../../node_modules/@angular/cli/bin/ng.js build",
    "build": "npm run build:api && npm run build:web",
    "seed": "cross-env SEED_DB=true node apps/api/dist/main.js"
  }
}
